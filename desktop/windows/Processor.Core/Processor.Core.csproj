<Project Sdk="Microsoft.NET.Sdk">

  <!-- What DineroBook Processor and DineroBook Manager do, without the
       service or the window: the folder sweep, the ledger, the upload
       answers, the agent key on disk (DPAPI) and the sign-in calls.
       Windows only (DPAPI, file ACLs), AnyCPU so the tests run on any
       Windows machine. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>DineroBook.Processor</RootNamespace>
    <AssemblyName>DineroBook.Processor.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Processor.Tests" />
  </ItemGroup>

</Project>
