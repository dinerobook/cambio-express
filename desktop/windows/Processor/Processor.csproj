<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- DineroBook Processor: the Windows service (DineroBookProcessor) that
       sends Passport's BOOutbox files to DineroBook. Replaces the Python
       site agent (agent/) for new installs. Published as one .exe by
       .github/workflows/dinerobook-processor.yml. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>DineroBookProcessor</AssemblyName>
    <RootNamespace>DineroBook.Processor.Service</RootNamespace>
    <Product>DineroBook Processor</Product>
    <Company>DineroBook</Company>
    <Version>0.1.0</Version>
    <!-- No appsettings.json: everything comes from ProgramData. -->
    <UserSecretsId></UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Processor.Core/Processor.Core.csproj" />
  </ItemGroup>

</Project>
